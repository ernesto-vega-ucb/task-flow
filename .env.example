# Copia este archivo a .env y ajusta los valores si es necesario.
# Todos los valores tienen defaults en docker-compose.yml, .env es opcional.

# ============================================================
# VERSIÓN GLOBAL DE LA PLATAFORMA (única)
# ------------------------------------------------------------
# El pipeline de Jenkins incrementa automáticamente el parche
# (ej. v1.1.0 -> v1.1.1) cuando detecta cambios en 'backend/'
# o 'frontend/' (git diff --name-only HEAD~1). Si ninguno de los
# dos directorios cambió, NO se incrementa y no se generan imágenes.
# Las imágenes se nombran: taskflow-backend:<APP_VERSION> y
# taskflow-frontend:<APP_VERSION>. La UI muestra esta versión.
# ============================================================
APP_VERSION=v1.1.0

# PostgreSQL
DB_NAME=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow
DB_HOST_PORT=5432
POSTGRES_IMAGE=postgres:16-alpine

# Puertos de exposición
FRONTEND_PORT=80

# Orígenes permitidos por CORS en el backend (con gateway no es crítico)
CORS_ALLOWED_ORIGINS=*
