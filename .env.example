# Copia este archivo a .env y ajusta los valores si es necesario.
# Todos los valores tienen defaults en docker-compose.yml, .env es opcional.

# PostgreSQL
DB_NAME=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow
DB_HOST_PORT=5432

# Puertos de exposición
FRONTEND_PORT=80

# Imágenes (se pueden fijar por tag/version en despliegues)
BACKEND_IMAGE=taskflow-backend:latest
FRONTEND_IMAGE=taskflow-frontend:latest

# Orígenes permitidos por CORS en el backend (con gateway no es crítico)
CORS_ALLOWED_ORIGINS=*
