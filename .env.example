# Copia este archivo a .env y ajusta los valores si es necesario.
# Todos los valores tienen defaults en docker-compose.yml, .env es opcional.

# PostgreSQL
DB_NAME=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow
DB_HOST_PORT=5432

# Puertos de exposición
BACKEND_PORT=8080
FRONTEND_PORT=3000

# URL de la API que el navegador usará (se inyecta en tiempo de BUILD del frontend)
VITE_API_BASE_URL=http://localhost:8080/api

# Orígenes permitidos por CORS en el backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
